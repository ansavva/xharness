# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored; `.env.example` is committed as a template.

# Replicate API token — used by the `seedance-video` skill's
# upload_to_replicate.py to upload full-resolution reference images and pass
# them to predictions as HTTP URLs (no base64 in the agent context).
# Create one at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your_token_here

# NYT API key — used by the nytimes-briefing / nytimes-search skills.
# Create one at https://developer.nytimes.com/
NYT_API_KEY=your_nyt_key_here

# ---------------------------------------------------------------------------
# Google Drive — used by the `google-drive` skill (drive_upload.py /
# drive_download.py). seedance-video / fred build on it to store character
# reference images and generated videos in
# Drive instead of git. Bytes move disk<->Drive directly (no base64 in the agent
# context). Files land under a root folder in your My Drive (default: xharness).
#
# Recommended: a user OAuth credential, which writes into YOUR own Drive.
# Easiest one-time setup, no code (via the Google OAuth Playground):
#   1. https://console.cloud.google.com → create/pick a project.
#   2. "APIs & Services" → Library → enable the "Google Drive API".
#   3. "APIs & Services" → OAuth consent screen → User type External; add your
#      Google account under "Test users". (Optional: click "Publish app" so the
#      refresh token doesn't expire after 7 days — Testing-mode tokens do.)
#   4. "APIs & Services" → Credentials → Create credentials → OAuth client ID →
#      type "Web application". Under "Authorized redirect URIs" add:
#         https://developers.google.com/oauthplayground
#      Save, then copy the Client ID and Client secret.
#   5. https://developers.google.com/oauthplayground → gear icon (top right) →
#      check "Use your own OAuth credentials" → paste the client ID + secret.
#   6. In "Input your own scopes" (left) enter:
#         https://www.googleapis.com/auth/drive.file
#      (non-sensitive — access only to files this app creates, which is all these
#       scripts need, and it avoids the "unverified app" warning. Use
#       .../auth/drive only if you need access to files the app didn't create.)
#      → "Authorize APIs" → sign in as the Drive account → allow.
#   7. Click "Exchange authorization code for tokens". Copy the "Refresh token".
#   8. Paste the three values below.
#
# Even easier once CLIENT_ID + CLIENT_SECRET are set: add
#   http://localhost:8765/
# as an Authorized redirect URI on the OAuth client, then run
#   uv run .claude/skills/google-drive/scripts/drive_auth.py
# It runs the consent flow in your browser and writes GOOGLE_DRIVE_REFRESH_TOKEN
# below automatically (re-run it whenever the token expires).
GOOGLE_DRIVE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_DRIVE_REFRESH_TOKEN=your_oauth_refresh_token

# Optional: a ready-made OAuth access token (skips the refresh flow; expires in
# ~1h — handy for a quick test). If set, it takes precedence over the trio above.
# GOOGLE_DRIVE_ACCESS_TOKEN=ya29_your_access_token

# Optional: change the top-level Drive folder everything is stored under.
# GOOGLE_DRIVE_ROOT_FOLDER=xharness
