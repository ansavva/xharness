{
  "permissions": {
    "allow": [
      "Bash(uv run*)",
      "Bash(which ebook-convert)",
      "Bash(which exiftool)",
      "Bash(aws sts get-caller-identity*)",
      "Bash(aws s3 ls*)",
      "Bash(aws configure export-credentials*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
